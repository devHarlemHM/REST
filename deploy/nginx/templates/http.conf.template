map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    server_name ${ADMIN_DOMAIN};

    location = /nginx-health { access_log off; return 200 "ok\n"; }
    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    location /api/ { include /etc/nginx/proxy_params; proxy_pass http://backend:3000; proxy_read_timeout 300s; }
    location /socket.io/ { include /etc/nginx/proxy_params; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_pass http://backend:3000; }
    location / { proxy_pass http://admin:80; proxy_set_header Host $host; }
}

server {
    listen 80;
    server_name ${APP_DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    location /api/ { include /etc/nginx/proxy_params; proxy_pass http://backend:3000; proxy_read_timeout 300s; }
    location /socket.io/ { include /etc/nginx/proxy_params; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_pass http://backend:3000; }
    location / { proxy_pass http://app:80; proxy_set_header Host $host; }
}
