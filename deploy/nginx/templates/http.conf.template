map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server { listen ${HTTP_PORT} default_server; server_name ${ADMIN_DOMAIN}; location = /nginx-health { access_log off; return 200 "ok\n"; } location /.well-known/acme-challenge/ { root /var/www/certbot; } location / { proxy_pass http://admin:${ADMIN_PORT}; proxy_set_header Host $host; } }
server { listen ${HTTP_PORT}; server_name ${APP_DOMAIN}; location /.well-known/acme-challenge/ { root /var/www/certbot; } location / { proxy_pass http://app:${APP_PORT}; proxy_set_header Host $host; } }
server { listen ${HTTP_PORT}; server_name ${API_DOMAIN}; location /.well-known/acme-challenge/ { root /var/www/certbot; } location /api/ { include /etc/nginx/proxy_params; proxy_pass http://backend:${BACKEND_PORT}; proxy_read_timeout 300s; } location /socket.io/ { include /etc/nginx/proxy_params; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_pass http://backend:${BACKEND_PORT}; } location / { include /etc/nginx/proxy_params; proxy_pass http://backend:${BACKEND_PORT}; } }
server { listen ${HTTP_PORT}; server_name ${TEST_ADMIN_DOMAIN}; location /.well-known/acme-challenge/ { root /var/www/certbot; } location / { proxy_pass http://testadmin:${TEST_ADMIN_PORT}; proxy_set_header Host $host; } }
server { listen ${HTTP_PORT}; server_name ${TEST_APP_DOMAIN}; location /.well-known/acme-challenge/ { root /var/www/certbot; } location / { proxy_pass http://testapp:${TEST_APP_PORT}; proxy_set_header Host $host; } }
server { listen ${HTTP_PORT}; server_name ${TEST_API_DOMAIN}; location /.well-known/acme-challenge/ { root /var/www/certbot; } location /api/ { include /etc/nginx/proxy_params; proxy_pass http://testbackend:${TEST_BACKEND_PORT}; proxy_read_timeout 300s; } location /socket.io/ { include /etc/nginx/proxy_params; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_pass http://testbackend:${TEST_BACKEND_PORT}; } location / { include /etc/nginx/proxy_params; proxy_pass http://testbackend:${TEST_BACKEND_PORT}; } }
