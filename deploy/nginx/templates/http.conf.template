map $http_upgrade $connection_upgrade { default upgrade; '' close; }
resolver 127.0.0.11 ipv6=off valid=10s;

server { listen ${HTTP_PORT} default_server; server_name ${ADMIN_DOMAIN}; set $upstream http://prodadmin:${ADMIN_PORT}; location = /nginx-health { access_log off; return 200 "ok\n"; } location /.well-known/acme-challenge/ { root /var/www/certbot; } location / { proxy_pass $upstream; proxy_set_header Host $host; } }
server { listen ${HTTP_PORT}; server_name ${APP_DOMAIN}; set $upstream http://prodapp:${APP_PORT}; location /.well-known/acme-challenge/ { root /var/www/certbot; } location / { proxy_pass $upstream; proxy_set_header Host $host; } }
server { listen ${HTTP_PORT}; server_name ${API_DOMAIN}; set $upstream http://prodbackend:${BACKEND_PORT}; location /.well-known/acme-challenge/ { root /var/www/certbot; } location /api/ { include /etc/nginx/proxy_params; proxy_pass $upstream; proxy_read_timeout 300s; } location /socket.io/ { include /etc/nginx/proxy_params; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_pass $upstream; } location / { include /etc/nginx/proxy_params; proxy_pass $upstream; } }
server { listen ${HTTP_PORT}; server_name ${TEST_ADMIN_DOMAIN}; set $upstream http://testadmin:${TEST_ADMIN_PORT}; location /.well-known/acme-challenge/ { root /var/www/certbot; } location / { proxy_pass $upstream; proxy_set_header Host $host; } }
server { listen ${HTTP_PORT}; server_name ${TEST_APP_DOMAIN}; set $upstream http://testapp:${TEST_APP_PORT}; location /.well-known/acme-challenge/ { root /var/www/certbot; } location / { proxy_pass $upstream; proxy_set_header Host $host; } }
server { listen ${HTTP_PORT}; server_name ${TEST_API_DOMAIN}; set $upstream http://testbackend:${TEST_BACKEND_PORT}; location /.well-known/acme-challenge/ { root /var/www/certbot; } location /api/ { include /etc/nginx/proxy_params; proxy_pass $upstream; proxy_read_timeout 300s; } location /socket.io/ { include /etc/nginx/proxy_params; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_pass $upstream; } location / { include /etc/nginx/proxy_params; proxy_pass $upstream; } }
