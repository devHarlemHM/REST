map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server { listen ${HTTP_PORT} default_server; server_name ${ADMIN_DOMAIN} ${APP_DOMAIN} ${API_DOMAIN} ${TEST_ADMIN_DOMAIN} ${TEST_APP_DOMAIN} ${TEST_API_DOMAIN}; location = /nginx-health { access_log off; return 200 "ok\n"; } location /.well-known/acme-challenge/ { root /var/www/certbot; } location / { return 301 https://$host$request_uri; } }

server { listen ${HTTPS_PORT} ssl; http2 on; server_name ${ADMIN_DOMAIN}; ssl_certificate /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem; ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem; ssl_protocols TLSv1.2 TLSv1.3; add_header X-Content-Type-Options nosniff always; add_header X-Frame-Options SAMEORIGIN always; add_header Referrer-Policy strict-origin-when-cross-origin always; location / { proxy_pass http://admin:${ADMIN_PORT}; proxy_set_header Host $host; } }
server { listen ${HTTPS_PORT} ssl; http2 on; server_name ${APP_DOMAIN}; ssl_certificate /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem; ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem; ssl_protocols TLSv1.2 TLSv1.3; add_header X-Content-Type-Options nosniff always; add_header X-Frame-Options SAMEORIGIN always; add_header Referrer-Policy strict-origin-when-cross-origin always; location / { proxy_pass http://app:${APP_PORT}; proxy_set_header Host $host; } }
server { listen ${HTTPS_PORT} ssl; http2 on; server_name ${API_DOMAIN}; ssl_certificate /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem; ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem; ssl_protocols TLSv1.2 TLSv1.3; add_header X-Content-Type-Options nosniff always; add_header X-Frame-Options SAMEORIGIN always; add_header Referrer-Policy strict-origin-when-cross-origin always; location /api/ { include /etc/nginx/proxy_params; proxy_pass http://backend:${BACKEND_PORT}; proxy_read_timeout 300s; } location /socket.io/ { include /etc/nginx/proxy_params; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_pass http://backend:${BACKEND_PORT}; } location / { include /etc/nginx/proxy_params; proxy_pass http://backend:${BACKEND_PORT}; } }
server { listen ${HTTPS_PORT} ssl; http2 on; server_name ${TEST_ADMIN_DOMAIN}; ssl_certificate /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem; ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem; ssl_protocols TLSv1.2 TLSv1.3; add_header X-Content-Type-Options nosniff always; add_header X-Frame-Options SAMEORIGIN always; add_header Referrer-Policy strict-origin-when-cross-origin always; location / { proxy_pass http://testadmin:${TEST_ADMIN_PORT}; proxy_set_header Host $host; } }
server { listen ${HTTPS_PORT} ssl; http2 on; server_name ${TEST_APP_DOMAIN}; ssl_certificate /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem; ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem; ssl_protocols TLSv1.2 TLSv1.3; add_header X-Content-Type-Options nosniff always; add_header X-Frame-Options SAMEORIGIN always; add_header Referrer-Policy strict-origin-when-cross-origin always; location / { proxy_pass http://testapp:${TEST_APP_PORT}; proxy_set_header Host $host; } }
server { listen ${HTTPS_PORT} ssl; http2 on; server_name ${TEST_API_DOMAIN}; ssl_certificate /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem; ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem; ssl_protocols TLSv1.2 TLSv1.3; add_header X-Content-Type-Options nosniff always; add_header X-Frame-Options SAMEORIGIN always; add_header Referrer-Policy strict-origin-when-cross-origin always; location /api/ { include /etc/nginx/proxy_params; proxy_pass http://testbackend:${TEST_BACKEND_PORT}; proxy_read_timeout 300s; } location /socket.io/ { include /etc/nginx/proxy_params; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_pass http://testbackend:${TEST_BACKEND_PORT}; } location / { include /etc/nginx/proxy_params; proxy_pass http://testbackend:${TEST_BACKEND_PORT}; } }
